{
  "expo": {
    "name": "ZenFit",
    "slug": "zenfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_white.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo_white.png",
      "resizeMode": "contain",
      "backgroundColor": "#060509"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zenfit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_white.png",
        "backgroundColor": "#060509"
      },
      "package": "com.zenfit.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-av",
      "expo-image-picker"
    ],
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "f3cf9c90-9869-402e-8e70-01180f9fe430"
      }
    }
  }
}
