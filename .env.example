# ==============================================================================
# ZenFit Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# Note: ZenFit is an offline-first native application.
# None of these values are required for full offline workout tracking.
# ==============================================================================

# Application Environment ('development' | 'preview' | 'production')
NODE_ENV=development

# Optional: Firebase Anonymous Cloud Sync & Remote Backup
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""

# Optional: Expo Application Services (EAS) Project Identifier
EXPO_PUBLIC_EAS_PROJECT_ID=""

# Optional: Local Debug & Telemetry Flags (default: false)
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=false
EXPO_PUBLIC_ENABLE_PERF_MONITOR=false

